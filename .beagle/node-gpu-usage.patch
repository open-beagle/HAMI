+// GPUUsageSummary represents GPU usage summary for node annotation.
+type GPUUsageSummary struct {
+	ID          string `json:"id"`
+	TotalCount  int32  `json:"total_count"`
+	UsedCount   int32  `json:"used_count"`
+	TotalMemory int32  `json:"total_memory"`
+	UsedMemory  int32  `json:"used_memory"`
+	TotalCore   int32  `json:"total_core"`
+	UsedCore    int32  `json:"used_core"`
+}
+
+// PodGPUUsage represents pod GPU usage for node annotation.
+type PodGPUUsage struct {
+	Namespace string `json:"namespace"`
+	Name      string `json:"name"`
+	Memory    int32  `json:"memory"`
+	Core      int32  `json:"core"`
+}
+
+const (
+	NodeGPUUsageAnnotation = "hami.io/node-gpu-usage"
+	NodeGPUPodsAnnotation  = "hami.io/node-gpu-pods"
+)
+
+// syncNodeGPUUsage syncs GPU usage information to node annotations.
+// Only updates when annotation values have changed to reduce API Server pressure.
+func (s *Scheduler) syncNodeGPUUsage(nodeID string, usage *NodeUsage) error {
+	if usage == nil || len(usage.Devices.DeviceLists) == 0 {
+		return nil
+	}
+
+	// Build GPU usage summary
+	summaryMap := make(map[string]*GPUUsageSummary)
+	for _, dev := range usage.Devices.DeviceLists {
+		summaryMap[dev.Device.ID] = &GPUUsageSummary{
+			ID:          dev.Device.ID,
+			TotalCount:  dev.Device.Count,
+			UsedCount:   dev.Device.Used,
+			TotalMemory: dev.Device.Totalmem,
+			UsedMemory:  dev.Device.Usedmem,
+			TotalCore:   dev.Device.Totalcore,
+			UsedCore:    dev.Device.Usedcores,
+		}
+	}
+
+	// Build pod usage details
+	podsMap := make(map[string][]PodGPUUsage)
+	for _, p := range s.ListPodsInfo() {
+		if p.NodeID != nodeID {
+			continue
+		}
+		for _, devList := range p.Devices {
+			for _, ctrs := range devList {
+				for _, ctr := range ctrs {
+					deviceID := ctr.UUID
+					if idx := strings.Index(deviceID, "["); idx != -1 {
+						deviceID = deviceID[:idx]
+					}
+					podsMap[deviceID] = append(podsMap[deviceID], PodGPUUsage{
+						Namespace: p.Namespace,
+						Name:      p.Name,
+						Memory:    ctr.Usedmem,
+						Core:      ctr.Usedcores,
+					})
+				}
+			}
+		}
+	}
+
+	// Serialize to JSON
+	summaryJSON, _ := json.Marshal(summaryMap)
+	podsJSON, _ := json.Marshal(podsMap)
+
+	// Get current node to check existing annotations
+	node, err := util.GetNode(nodeID)
+	if err != nil {
+		return err
+	}
+
+	// Check if annotations have changed
+	currentUsage := node.Annotations[NodeGPUUsageAnnotation]
+	currentPods := node.Annotations[NodeGPUPodsAnnotation]
+	newUsage := string(summaryJSON)
+	newPods := string(podsJSON)
+
+	if currentUsage == newUsage && currentPods == newPods {
+		return nil
+	}
+
+	// Only patch when values changed
+	annos := map[string]string{
+		NodeGPUUsageAnnotation: newUsage,
+		NodeGPUPodsAnnotation:  newPods,
+	}
+	return util.PatchNodeAnnotations(node, annos)
+}

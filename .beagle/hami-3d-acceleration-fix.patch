+// isWholeCardAllocation checks if all requested devices are allocated at 100% capacity.
+// Returns true if all devices have Usedcores == 100 AND Usedmem equals the GPU's total memory,
+// indicating a whole card allocation.
+// Returns false if any device has Usedcores < 100 or Usedmem < total GPU memory, indicating a shared allocation.
+// In whole card mode, libvgpu.so and ld.so.preload are not mounted to allow direct access
+// to the GPU driver, which enables 3D acceleration support.
+func (plugin *NvidiaDevicePlugin) isWholeCardAllocation(devreq []util.ContainerDevice) bool {
+	if len(devreq) == 0 {
+		return false
+	}
+
+	devs := plugin.getAPIDevices()
+	for _, dev := range devreq {
+
+		// Check if cores are fully allocated (100%)
+		if dev.Usedcores < 100 && dev.Usedcores > 0 {
+			klog.Infof("Device %s: Usedcores=%d, Totalcores=%d, not a whole card allocation", dev.UUID, dev.Usedmem, 100)
+			return false
+		}
+
+		// Convert total memory from bytes to MiB (same unit as Usedmem)
+		for _, v := range *devs {
+			if v.ID == dev.UUID {
+				// Check if used memory equals total memory
+				klog.Infof("Device %s: Usedmem=%d, TotalMem=%d, not a whole card allocation", dev.UUID, dev.Usedmem, v.Devmem)
+				if dev.Usedmem != v.Devmem {
+					klog.Infof("Device %s: Usedmem=%d, TotalMem=%d, not a whole card allocation", dev.UUID, dev.Usedmem, v.Devmem)
+					return false
+				}
+			}
+		}
+
+	}
+
+	return true
+}
